# API configuration
# Leave these commented out to use automatic host detection
# The app will automatically use:
# - localhost:8000 when running locally
# - [current-host]:8000 when deployed

# Uncomment and set these to override automatic detection:
# VITE_API_HOST=localhost:8000
# VITE_API_PROTOCOL=http

# For production with a different API server:
# VITE_API_HOST=api.yourdomain.com:8000
# VITE_API_PROTOCOL=https

# For production on same server but different port:
# VITE_API_HOST=yourdomain.com:8000
# VITE_API_PROTOCOL=https