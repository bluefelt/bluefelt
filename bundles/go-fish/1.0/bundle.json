{
  "game_id": "go-fish",
  "manifest": {
    "gameId": "go-fish",
    "version": "1.0",
    "specVersion": "1.0",
    "metadata": {
      "name": "Go Fish",
      "description": "Classic card collection game where players ask each other for cards to form pairs",
      "author": "Bluefelt Team",
      "players": {
        "min": 2,
        "max": 4
      }
    },
    "zoneGroups": [
      {
        "id": "play-area",
        "title": "Play Area",
        "zones": [
          "pool"
        ]
      },
      {
        "id": "player-areas",
        "title": "Players",
        "zones": [
          "hand_{player}",
          "pairs_{player}",
          "choice_{player}"
        ]
      }
    ]
  },
  "actions": [
    {
      "auto": true,
      "id": "dealCards",
      "name": "Deal Cards to Players",
      "then": [
        {
          "action": "dealToP2"
        }
      ],
      "ui": {
        "logTemplate": "Dealing 7 cards to p1"
      },
      "uses": "draw",
      "with": {
        "count": 7,
        "from": "/zones/pool",
        "to": "/zones/hand_p1"
      }
    },
    {
      "auto": true,
      "id": "dealToP2",
      "name": "Deal Cards to P2",
      "then": [
        {
          "action": "beginTurns"
        }
      ],
      "ui": {
        "logTemplate": "Dealing 7 cards to p2"
      },
      "uses": "draw",
      "with": {
        "count": 7,
        "from": "/zones/pool",
        "to": "/zones/hand_p2"
      }
    },
    {
      "auto": true,
      "id": "beginTurns",
      "name": "Begin Game Turns",
      "ui": {
        "logTemplate": "Starting game - {player} goes first"
      },
      "uses": "setPhase",
      "with": {
        "phase": "selectingRank",
        "phaseSet": "game"
      }
    },
    {
      "auto": true,
      "id": "startTurn",
      "name": "Start Turn",
      "uses": "setState",
      "when": [
        {
          "condition": "phase.is",
          "with": {
            "phase": "selectingRank",
            "phaseSet": "game"
          }
        },
        {
          "condition": "player.isActor"
        }
      ],
      "with": {
        "path": "/selection/availableRanks",
        "value": [
          "a",
          "2",
          "3",
          "4",
          "5",
          "6",
          "7",
          "8",
          "9",
          "10",
          "j",
          "q",
          "k"
        ]
      }
    },
    {
      "id": "selectRank",
      "name": "Select Rank",
      "then": [
        {
          "action": "transitionToSelectingPlayer"
        }
      ],
      "ui": {
        "direction": "Choose a rank to ask for",
        "logTemplate": "{player} will ask for {args.rank}s"
      },
      "uses": "setState",
      "when": [
        {
          "condition": "phase.is",
          "with": {
            "phase": "selectingRank",
            "phaseSet": "game"
          }
        },
        {
          "condition": "player.isActor"
        }
      ],
      "with": {
        "path": "/selection/selectedRank",
        "value": "{args.rank}"
      }
    },
    {
      "id": "selectPlayer",
      "name": "Ask Player",
      "then": [
        {
          "action": "transitionToResponding"
        }
      ],
      "ui": {
        "direction": "Choose another player to ask for {selection.selectedRank}s",
        "logTemplate": "{player} asks {args.targetPlayer} for {selection.selectedRank}s"
      },
      "uses": "setState",
      "when": [
        {
          "condition": "phase.is",
          "with": {
            "phase": "selectingPlayer",
            "phaseSet": "game"
          }
        },
        {
          "condition": "player.isActor"
        },
        {
          "condition": "value.notEquals",
          "with": {
            "value1": "{args.targetPlayer}",
            "value2": "{player}"
          }
        }
      ],
      "with": {
        "path": "/selection/targetPlayer",
        "value": "{args.targetPlayer}"
      }
    },
    {
      "auto": true,
      "id": "checkPlayerCards",
      "name": "Check Player Response",
      "uses": "conditionalAction",
      "when": [
        {
          "condition": "phase.is",
          "with": {
            "phase": "responding",
            "phaseSet": "game"
          }
        }
      ],
      "with": {
        "condition": [
          {
            "condition": "zone.hasMatching",
            "with": {
              "property": "rank",
              "value": "{selection.selectedRank}",
              "zone": "/zones/hand_{selection.targetPlayer}"
            }
          }
        ],
        "ifFalse": [
          {
            "action": "transitionToFishing"
          }
        ],
        "ifTrue": [
          {
            "action": "transferCards",
            "with": {
              "from": "/zones/hand_{selection.targetPlayer}",
              "property": "rank",
              "to": "/zones/hand_{player}",
              "value": "{selection.selectedRank}"
            }
          },
          {
            "action": "checkForBooksWithRank",
            "with": {
              "player": "{player}",
              "rank": "{selection.selectedRank}"
            }
          },
          {
            "action": "transitionToSelectingRank"
          }
        ]
      }
    },
    {
      "auto": true,
      "id": "storePreDrawCount",
      "name": "Store Pre-Draw Count",
      "uses": "queryEntities",
      "when": [
        {
          "condition": "phase.is",
          "with": {
            "phase": "fishing",
            "phaseSet": "game"
          }
        }
      ],
      "with": {
        "property": "rank",
        "storePath": "/selection/preDrawCount",
        "value": "{selection.selectedRank}",
        "zone": "/zones/hand_{player}"
      }
    },
    {
      "auto": true,
      "id": "goFish",
      "name": "Go Fish!",
      "then": [
        {
          "action": "checkIfRankCountIncreased"
        }
      ],
      "ui": {
        "logTemplate": "Go Fish! {player} draws a card from the pool"
      },
      "uses": "draw",
      "when": [
        {
          "condition": "phase.is",
          "with": {
            "phase": "fishing",
            "phaseSet": "game"
          }
        },
        {
          "condition": "zone.count",
          "with": {
            "operator": ">",
            "value": 0,
            "zone": "/zones/pool"
          }
        }
      ],
      "with": {
        "count": 1,
        "from": "/zones/pool",
        "to": "/zones/hand_{player}"
      }
    },
    {
      "auto": true,
      "id": "checkForBooks",
      "name": "Check for Pairs",
      "ui": {
        "logTemplate": "{player} checks for pairs"
      },
      "uses": "formPairs",
      "with": {
        "player": "{player}"
      }
    },
    {
      "auto": true,
      "id": "checkForBooksWithRank",
      "name": "Check for Pairs of Specific Rank",
      "ui": {
        "logTemplate": "{player} forms a pair of {args.rank}s"
      },
      "uses": "formPairs",
      "with": {
        "player": "{player}",
        "rank": "{args.rank}"
      }
    },
    {
      "auto": true,
      "id": "checkGameEnd",
      "name": "Check Game End",
      "uses": "conditionalAction",
      "when": [
        {
          "condition": "phase.is",
          "with": {
            "phase": "selectingRank",
            "phaseSet": "game"
          }
        }
      ],
      "with": {
        "condition": [
          {
            "condition": "zone.count",
            "with": {
              "operator": "==",
              "value": 0,
              "zone": "/zones/pool"
            }
          }
        ],
        "ifFalse": [],
        "ifTrue": [
          {
            "action": "transitionToGameOver"
          },
          {
            "action": "calculateWinner"
          }
        ]
      }
    },
    {
      "auto": true,
      "id": "calculateWinner",
      "name": "Calculate Winner",
      "ui": {
        "logTemplate": "Calculating winner based on pairs collected"
      },
      "uses": "calculateWinner",
      "when": [
        {
          "condition": "phase.is",
          "with": {
            "phase": "gameOver",
            "phaseSet": "game"
          }
        }
      ]
    },
    {
      "auto": true,
      "id": "transferCards",
      "name": "Transfer Cards",
      "ui": {
        "logTemplate": "{selection.targetPlayer} has {selection.selectedRank}s and gives them to {player}"
      },
      "uses": "transferMatching"
    },
    {
      "auto": true,
      "id": "checkIfRankCountIncreased",
      "name": "Check If Rank Count Increased",
      "then": [
        {
          "action": "compareCountsAndAdvance"
        }
      ],
      "uses": "queryEntities",
      "with": {
        "property": "rank",
        "storePath": "/selection/postDrawCount",
        "value": "{selection.selectedRank}",
        "zone": "/zones/hand_{player}"
      }
    },
    {
      "auto": true,
      "id": "compareCountsAndAdvance",
      "name": "Compare Counts and Advance Turn",
      "uses": "conditionalAction",
      "with": {
        "condition": [
          {
            "condition": "value.greaterThan",
            "with": {
              "value1": "{selection.postDrawCount}",
              "value2": "{selection.preDrawCount}"
            }
          }
        ],
        "ifFalse": [
          {
            "action": "checkForBooksWithRank",
            "with": {
              "player": "{player}",
              "rank": "{selection.selectedRank}"
            }
          },
          {
            "action": "advanceTurn"
          },
          {
            "action": "transitionToSelectingRank"
          }
        ],
        "ifTrue": [
          {
            "action": "checkForBooksWithRank",
            "with": {
              "player": "{player}",
              "rank": "{selection.selectedRank}"
            }
          },
          {
            "action": "continueAfterDrawingRequestedRank"
          }
        ]
      }
    },
    {
      "auto": true,
      "id": "transitionToSelectingPlayer",
      "name": "Transition to Selecting Player",
      "uses": "setPhase",
      "with": {
        "phase": "selectingPlayer",
        "phaseSet": "game"
      }
    },
    {
      "auto": true,
      "id": "transitionToResponding",
      "name": "Transition to Responding",
      "uses": "setPhase",
      "with": {
        "phase": "responding",
        "phaseSet": "game"
      }
    },
    {
      "auto": true,
      "id": "transitionToCheckingPairs",
      "name": "Transition to Checking Pairs",
      "uses": "setPhase",
      "with": {
        "phase": "checkingPairs",
        "phaseSet": "game"
      }
    },
    {
      "auto": true,
      "id": "transitionToFishing",
      "name": "Transition to Fishing",
      "then": [
        {
          "action": "storePreDrawCount"
        }
      ],
      "ui": {
        "logTemplate": "{selection.targetPlayer} says 'Go Fish!'"
      },
      "uses": "setPhase",
      "with": {
        "phase": "fishing",
        "phaseSet": "game"
      }
    },
    {
      "auto": true,
      "id": "transitionToSelectingRank",
      "name": "Transition to Selecting Rank",
      "uses": "setPhase",
      "with": {
        "phase": "selectingRank",
        "phaseSet": "game"
      }
    },
    {
      "auto": true,
      "id": "transitionToGameOver",
      "name": "Transition to Game Over",
      "ui": {
        "logTemplate": "Game Over! Counting pairs to determine the winner..."
      },
      "uses": "setPhase",
      "with": {
        "phase": "gameOver",
        "phaseSet": "game"
      }
    },
    {
      "auto": true,
      "id": "continueAfterDrawingRequestedRank",
      "name": "Continue After Drawing Requested Rank",
      "ui": {
        "logTemplate": "{player} drew a {selection.selectedRank} and gets another turn!"
      },
      "uses": "setPhase",
      "with": {
        "phase": "selectingRank",
        "phaseSet": "game"
      }
    },
    {
      "auto": true,
      "id": "advanceTurn",
      "name": "Advance Turn",
      "ui": {
        "logTemplate": "Turn passes to {nextPlayer}"
      },
      "uses": "nextTurn"
    }
  ],
  "entities": [
    {
      "generate": true,
      "id": "standardDeck"
    },
    {
      "id": "score_{player}",
      "name": "Player {player} Score",
      "type": "counter",
      "value": 0
    }
  ],
  "phases": [
    {
      "id": "game",
      "name": "Go Fish Game",
      "phases": [
        {
          "enterActions": [
            "dealCards"
          ],
          "id": "dealing",
          "initial": true,
          "name": "Dealing cards to players"
        },
        {
          "enterActions": [
            "startTurn"
          ],
          "id": "selectingRank",
          "name": "Choose a rank to ask for",
          "possibleActions": [
            "selectRank"
          ],
          "ui": {
            "prompt": "Choose a rank to ask for"
          }
        },
        {
          "id": "selectingPlayer",
          "name": "Choose a player to ask",
          "possibleActions": [
            "selectPlayer"
          ]
        },
        {
          "enterActions": [
            "checkPlayerCards"
          ],
          "id": "responding",
          "name": "Responding to request",
          "possibleActions": [
            "checkPlayerCards",
            "goFish"
          ]
        },
        {
          "enterActions": [
            "goFish"
          ],
          "id": "fishing",
          "name": "Drawing from pool",
          "possibleActions": [
            "goFish"
          ]
        },
        {
          "enterActions": [
            "checkForBooks"
          ],
          "id": "checkingPairs",
          "name": "Checking for pairs",
          "possibleActions": [
            "checkForBooks",
            "checkGameEnd"
          ]
        },
        {
          "id": "gameOver",
          "name": "Game Over",
          "possibleActions": [
            "calculateWinner"
          ]
        }
      ]
    }
  ],
  "zones": [
    {
      "contents": "standardDeck",
      "id": "pool",
      "name": "Fishing Pool",
      "shape": "stack",
      "shapeMeta": {
        "shuffle": true
      },
      "visibility": "count"
    },
    {
      "id": "hand_{player}",
      "name": "Your Hand",
      "shape": "list",
      "visibility": "owner"
    },
    {
      "id": "pairs_{player}",
      "name": "Player {player} Pairs",
      "shape": "stack",
      "visibility": "public"
    },
    {
      "id": "choice_{player}",
      "name": "Select Rank",
      "shape": "choice",
      "visibility": "owner"
    }
  ]
}